{
  "name": "react-bibtex",
  "version": "0.2.1",
  "description": "Render BibTeX entries as React elements, with the LaTeX decoded and every fragment styleable.",
  "keywords": [
    "bibtex",
    "react",
    "citation",
    "bibliography",
    "latex",
    "references",
    "parser"
  ],
  "homepage": "https://avlyx.github.io/react-bibTex/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AVlyx/react-bibTex.git"
  },
  "bugs": "https://github.com/AVlyx/react-bibTex/issues",
  "license": "MIT",
  "author": "AVlyx",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test test/index.test.mjs test/parse.test.ts test/semantic.test.ts",
    "test:unit": "node --test test/parse.test.ts test/semantic.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
